<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SheetLite</AssemblyName>
    <RootNamespace>SheetLite</RootNamespace>
    <Version>0.7.0</Version>
    <Authors>SheetLite Contributors</Authors>
    <Description>A fast, portable, Dracula-themed CSV and XLSX workbook editor for Windows.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sheetlite.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SheetLite.Core.Tests" />
    <Compile Remove="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\sheetlite-icon.png" />
    <EmbeddedResource Include="Assets\window-minimize.png" />
    <EmbeddedResource Include="Assets\window-maximize.png" />
    <EmbeddedResource Include="Assets\window-close.png" />
  </ItemGroup>
</Project>
